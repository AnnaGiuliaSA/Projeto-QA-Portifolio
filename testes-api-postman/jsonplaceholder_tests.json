{
	"info": {
		"name": "JSONPlaceholder QA Tests",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Validar Listagem de Usuários",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code é 200', function () { pm.response.to.have.status(200); });",
							"pm.test('Validar contrato do JSON', function () { var jsonData = pm.response.json(); pm.expect(jsonData[0]).to.have.property('id'); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"url": "https://jsonplaceholder.typicode.com/users"
			}
		}
	]
}

